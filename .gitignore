# Personal Windows-local Claude Code directives
.claude-memory/

# Device validation photos (UC3 screen captures from baseline / regression checks)
WhatsApp Image*.jpeg

# Wire-capture diagnostics from cross-session debugging (reproducible — keep narrative in CHANGELOG / build logs)
_diag_capture_*.log

# MCP / harness telemetry from prior Claude Code sessions
/logs/

# build directories
/binaries
/build
/build-static
/test/build

# Claude Code: worktrees and the generated OpenSpec commands/skills.
/.claude

# OpenSpec commands and skills generated for an AI coding tool; every developer generates them for
# the tool they use: npx @fission-ai/openspec@1.14.1 init --tools <tool>  (see `--help` for the list)
**/commands/opsx*
**/command/opsx*
**/prompts/opsx*
**/workflows/opsx*
**/skills/openspec-*/
